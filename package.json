{
  "name": "sage",
  "private": true,
  "browserslist": [
    "extends @roots/browserslist-config"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "bud dev",
    "build": "bud build",
    "WSL:dev": "cd /mnt/c/My Files/Work/Madeo/Github/acumen-org && node node_modules/@roots/bud/bin/bud.mjs dev",
    "WSL:build": "cd /mnt/c/My Files/Work/Madeo/Github/acumen-org && node node_modules/@roots/bud/bin/bud.mjs build",
    "WSL:install": "cd /mnt/c/My Files/Work/Madeo/Github/acumen-org && npm install --no-bin-links",
    "translate": "yarn translate:pot && yarn translate:update",
    "translate:pot": "wp i18n make-pot . ./resources/lang/sage.pot --include=\"app,resources\"",
    "translate:update": "wp i18n update-po ./resources/lang/sage.pot ./resources/lang/*.po",
    "translate:compile": "yarn translate:mo && yarn translate:js",
    "translate:js": "wp i18n make-json ./resources/lang --pretty-print",
    "translate:mo": "wp i18n make-mo ./resources/lang ./resources/lang"
  },
  "devDependencies": {
    "@roots/bud": "^6.17.0",
    "@roots/bud-eslint": "^6.17.0",
    "@roots/bud-postcss": "^6.17.0",
    "@roots/bud-prettier": "^6.17.0",
    "@roots/bud-stylelint": "^6.17.0",
    "@roots/bud-tailwindcss": "^6.17.0",
    "@roots/bud-vue": "^6.17.0",
    "@roots/eslint-config": "^6.17.0",
    "@roots/sage": "^6.17.0",
    "alpinejs": "^3.13.2",
    "eslint-plugin-vue": "^9.17.0",
    "vue": "^3.3.4",
    "vue-inline-svg": "^3.1.2"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.13.3",
    "@alpinejs/focus": "^3.13.2",
    "@alpinejs/intersect": "^3.13.3",
    "@vueuse/components": "^10.7.2",
    "@vueuse/integrations": "^10.7.2",
    "focus-trap": "^7",
    "gsap": "^3.12.4",
    "split-type": "^0.3.4",
    "swiper": "^11.0.5",
    "vue-collapsed": "^1.3.0",
    "vue3-smooth-scrollbar": "^1.0.2"
  }
}
